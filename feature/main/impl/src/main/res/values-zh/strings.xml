<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Content description for the icon button that opens the settings screen. -->
    <string name="home_open_settings">打开设置</string>
    <!-- Displays the current count held by the home screen. -->
    <string name="home_count">计数：<xliff:g id="count" example="5">%1$d</xliff:g></string>
    <!-- Label for the button that increments the count. -->
    <string name="home_increment">增加</string>

    <!-- Onboarding -->
    <!-- Action at the corner of the onboarding that skips the whole flow. -->
    <string name="onboarding_skip">跳过</string>
    <!-- Action of a step that has nothing to choose, which moves on to the next one. -->
    <string name="onboarding_continue">继续</string>
    <!-- First step: what leads into its headline. -->
    <string name="onboarding_welcome_lead">欢迎使用</string>
    <!-- First step: its headline. -->
    <string name="onboarding_welcome_headline">My Application。</string>
    <!-- First step: the action that starts the flow. -->
    <string name="onboarding_welcome_action">带我看看。</string>
    <!-- Second step: what leads into its headline. -->
    <string name="onboarding_privacy_lead">不用账号，不连云端，没有追踪。</string>
    <!-- Second step: its headline. -->
    <string name="onboarding_privacy_headline">一切都留在这台设备上。</string>
    <!-- Second step: the line under its headline. -->
    <string name="onboarding_privacy_detail">你的设置只保存在手机里，不会被发送到任何地方。</string>
    <!-- Third step: what leads into its headline. -->
    <string name="onboarding_mascots_lead">认识一下吉祥物。</string>
    <!-- Third step: its headline. -->
    <string name="onboarding_mascots_headline">它们住在设置里。</string>
    <!-- Third step: the line under its headline. -->
    <string name="onboarding_mascots_detail">果冻和茉莉精灵。打开「设置」，再看「吉祥物」。</string>
    <!-- Fourth step: what leads into its headline. -->
    <string name="onboarding_theme_lead">把它变成你的。</string>
    <!-- Fourth step: its headline, above the choice of theme. -->
    <string name="onboarding_theme_headline">挑一个主题。</string>
    <!-- Fifth step: what leads into its headline. -->
    <string name="onboarding_done_lead">就这些了。</string>
    <!-- Fifth step: its headline. -->
    <string name="onboarding_done_headline">一切就绪。</string>
    <!-- Fifth step: the line under its headline. -->
    <string name="onboarding_done_detail">你在这里做的每个选择，都保存在「设置」里。</string>
    <!-- Fifth step: the action that leaves the onboarding and opens the app. -->
    <string name="onboarding_done_action">开始使用 My Application</string>
</resources>
